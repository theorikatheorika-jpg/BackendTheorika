PORT=3001
NODE_ENV=development

# Copy the Session pooler connection string from Supabase into backend/.env.
# Keep the database password private and URL-encode special characters.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set the rotated Cloudinary API environment URL in Render and backend/.env.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional: set this to the downloaded Supabase root certificate to verify the server certificate.
# SUPABASE_DB_CA_CERT=C:\certs\supabase-root.crt

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.theorika.in,https://theorika.in

# Generate a random secret of at least 32 characters.
RATE_LIMIT_HASH_SECRET=replace-this-with-at-least-32-random-characters
AUTH_TOKEN_SECRET=replace-this-with-a-different-random-secret-of-at-least-32-characters
TRUST_PROXY_HOPS=0

# Required in production to send registration verification messages.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# AMARA chat assistant: an Anthropic API key from https://platform.claude.com. Keep it private.
ANTHROPIC_API_KEY=
